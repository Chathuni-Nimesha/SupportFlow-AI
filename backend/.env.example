# Application
APP_NAME=SupportFlow AI
APP_ENV=development
# Set true in development to enable FastAPI /docs, /redoc, and /openapi.json.
# Production always disables debug and API docs regardless of this flag.
APP_DEBUG=true
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB (canonical)
# Use a quoted URI. URL-encode special characters in the password
# (e.g. @ -> %40, # -> %23, / -> %2F).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=supportflow_ai

# JWT
# Development may use this placeholder. Production WILL REFUSE TO START
# if JWT_SECRET is missing, empty, or a placeholder such as this value.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Production example (do not commit real secrets):
# APP_ENV=production
# APP_DEBUG=false
# JWT_SECRET=replace-with-a-long-random-secret

# ChromaDB
# Modes: http (server), persistent (local files), ephemeral (in-memory)
# Bind the Chroma server to localhost / a private network. Do not expose
# CHROMA_PORT on the public internet. Application-layer owner filters do
# not protect a publicly reachable Chroma HTTP server.
CHROMA_MODE=http
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=supportflow_knowledge
CHROMA_PERSIST_DIRECTORY=.chroma
# default = all-MiniLM-L6-v2 via Chroma DefaultEmbeddingFunction
# hash = deterministic offline embeddings (tests)
CHROMA_EMBEDDING_MODEL=default
# TLS for the Chroma HTTP client (server must actually serve HTTPS)
CHROMA_SSL=false
# Optional token. Only authenticates if the Chroma server is started with
# matching token auth. Leave empty for local unauthenticated localhost.
# CHROMA_AUTH_TOKEN=
# CHROMA_AUTH_HEADER=Authorization
#
# Production HTTP Chroma:
# - loopback host (localhost / 127.0.0.1) is allowed
# - a remote host requires CHROMA_SSL=true and/or CHROMA_AUTH_TOKEN
# - 0.0.0.0 is rejected

# Google Gemini (answer generation only)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Logging
LOG_LEVEL=INFO

# Auth rate limits (in-memory, single Uvicorn process only — not shared
# across workers or hosts). Counts all login/register requests per client IP.
AUTH_LOGIN_RATE_LIMIT=30
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=20
AUTH_REGISTER_RATE_WINDOW_SECONDS=60
