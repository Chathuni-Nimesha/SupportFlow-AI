# Application
APP_NAME=SupportFlow AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB (canonical)
# Use a quoted URI. URL-encode special characters in the password
# (e.g. @ -> %40, # -> %23, / -> %2F).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=supportflow_ai

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=supportflow_knowledge

# Google Gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Logging
LOG_LEVEL=INFO
