# Public API origin used by the browser. Vite inlines this at build time.
# Development (npm run dev) may use this localhost default.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production builds (npm run build) REQUIRE a non-localhost value, for example:
# VITE_API_BASE_URL=https://api.example.com/api/v1
# Do not put secrets, MongoDB URIs, JWT secrets, or Gemini keys here.
